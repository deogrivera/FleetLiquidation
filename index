<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gasoline Liquidation Tracker — DA-RFO I</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#152233;
    --ink-soft:#4a5a70;
    --paper:#f2f5f8;
    --surface:#ffffff;
    --line:#e0e6ee;
    --line-soft:#eef1f6;
    --brand:#0f4c5c;
    --brand-dark:#0a3641;
    --brand-tint:#e6eef0;
    --amber:#c8790f;
    --amber-tint:#fdf1de;
    --settled:#1f8a4c;
    --settled-bg:#e5f5ec;
    --settled-line:#bfe4cd;
    --pending:#c23b3b;
    --pending-bg:#fceaea;
    --pending-line:#f0c2c2;
    --incomplete:#a8710f;
    --incomplete-bg:#fdf1de;
    --incomplete-line:#f0d49f;
    --radius:14px;
    --shadow:0 1px 2px rgba(21,34,51,.04), 0 8px 24px -12px rgba(21,34,51,.12);
    font-family:'Inter',system-ui,sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:
      radial-gradient(1200px 500px at 15% -10%, #eef4f2 0%, transparent 60%),
      var(--paper);
    color:var(--ink);
    padding:28px 18px 60px;
    display:flex;
    justify-content:center;
  }
  .wrap{max-width:1440px;width:100%;}

  /* ---------- HEADER ---------- */
  .masthead{
    background:linear-gradient(135deg,var(--brand) 0%,var(--brand-dark) 100%);
    border-radius:var(--radius);
    padding:26px 28px;
    color:#eef6f4;
    box-shadow:var(--shadow);
    display:flex;
    flex-wrap:wrap;
    gap:20px;
    align-items:center;
    justify-content:space-between;
    position:relative;
    overflow:hidden;
  }
  .masthead::after{
    content:"";
    position:absolute;
    right:-60px; top:-60px;
    width:220px; height:220px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(200,121,15,.25) 0%, transparent 70%);
  }
  .masthead h1{
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:1.55rem;
    margin:0 0 4px;
    letter-spacing:.2px;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .masthead .eyebrow{
    font-size:.72rem;
    text-transform:uppercase;
    letter-spacing:1.4px;
    color:#a9c7c2;
    font-weight:600;
    margin-bottom:6px;
  }
  .sync-panel{
    display:flex;
    align-items:center;
    gap:14px;
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.16);
    padding:10px 16px;
    border-radius:10px;
    font-size:.82rem;
    z-index:1;
  }
  .sync-dot{width:8px;height:8px;border-radius:50%;background:#6ee7a8;flex-shrink:0;}
  .sync-dot.err{background:#f28b82;}
  .sync-dot.loading{background:#f5c453;animation:pulse 1.1s infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
  #syncLabel{color:#dfeeeb;}
  #syncTime{color:#a9c7c2;font-family:'JetBrains Mono',monospace;font-size:.78rem;}
  .refresh-btn{
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.28);
    color:#eef6f4;
    padding:6px 12px;
    border-radius:8px;
    cursor:pointer;
    font-size:.8rem;
    font-weight:500;
    display:flex;align-items:center;gap:6px;
    transition:.15s;
  }
  .refresh-btn:hover{background:rgba(255,255,255,.22);}
  .refresh-btn:disabled{opacity:.5;cursor:default;}
  .refresh-btn .spin{display:inline-block;}
  .refresh-btn .spin.on{animation:spin .8s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---------- GAUGE (signature element) ---------- */
  .gauge-card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:18px 22px;
    margin-top:16px;
    box-shadow:var(--shadow);
  }
  .gauge-top{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:10px;}
  .gauge-top .title{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:.95rem;color:var(--ink);}
  .gauge-top .pct{font-family:'JetBrains Mono',monospace;font-size:.85rem;color:var(--ink-soft);}
  .gauge-track{
    height:14px;
    border-radius:7px;
    overflow:hidden;
    display:flex;
    background:var(--line-soft);
    border:1px solid var(--line);
  }
  .gauge-seg{height:100%;transition:width .4s ease;}
  .gauge-seg.settled{background:var(--settled);}
  .gauge-seg.incomplete{background:var(--incomplete);}
  .gauge-seg.pending{background:var(--pending);}
  .gauge-legend{display:flex;gap:18px;margin-top:10px;flex-wrap:wrap;}
  .gauge-legend .item{display:flex;align-items:center;gap:6px;font-size:.8rem;color:var(--ink-soft);}
  .gauge-legend .sw{width:9px;height:9px;border-radius:3px;}
  .gauge-legend .sw.settled{background:var(--settled);}
  .gauge-legend .sw.incomplete{background:var(--incomplete);}
  .gauge-legend .sw.pending{background:var(--pending);}
  .gauge-legend b{color:var(--ink);font-family:'JetBrains Mono',monospace;font-weight:600;}

  /* ---------- TOOLBAR ---------- */
  .toolbar{
    display:flex;flex-wrap:wrap;gap:12px;align-items:center;
    margin-top:16px;
    background:var(--surface);
    border:1px solid var(--line);
    padding:12px 16px;
    border-radius:12px;
    box-shadow:var(--shadow);
  }
  .controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
  button{
    background:var(--surface);
    border:1px solid var(--line);
    padding:7px 14px;
    border-radius:8px;
    cursor:pointer;
    font-size:.84rem;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    transition:.15s;
  }
  button:hover{background:var(--paper);border-color:#c9d3e0;}
  button.primary{background:var(--brand);color:#fff;border-color:var(--brand);}
  button.primary:hover{background:var(--brand-dark);}
  button.danger{background:var(--pending);color:#fff;border-color:var(--pending);}
  button.danger:hover{background:#a52f2f;}
  button.ghost{background:transparent;border-color:var(--line);color:var(--ink-soft);}
  input[type="file"]{display:none;}
  .file-label{
    background:var(--surface);border:1px solid var(--line);padding:7px 14px;
    border-radius:8px;cursor:pointer;font-size:.84rem;color:var(--ink-soft);
  }
  .file-label:hover{background:var(--paper);}
  .search-box{
    padding:7px 12px;border:1px solid var(--line);border-radius:8px;
    font-size:.84rem;min-width:220px;font-family:'Inter',sans-serif;
    background:var(--surface);
  }
  .search-box:focus{outline:2px solid var(--brand);border-color:transparent;}
  .stats{display:flex;gap:22px;flex-wrap:wrap;margin-left:auto;}
  .stat{display:flex;align-items:baseline;gap:6px;}
  .stat-value{font-weight:700;font-size:1.15rem;font-family:'JetBrains Mono',monospace;}
  .stat-label{color:var(--ink-soft);font-size:.82rem;}
  .stat.settled .stat-value{color:var(--settled);}
  .stat.pending .stat-value{color:var(--pending);}
  .stat.incomplete .stat-value{color:var(--incomplete);}

  /* column visibility */
  .col-visibility{position:relative;display:inline-block;}
  .col-visibility-dropdown{
    display:none;position:absolute;top:100%;left:0;background:var(--surface);
    border:1px solid var(--line);border-radius:10px;padding:10px 14px;min-width:210px;
    max-height:300px;overflow-y:auto;box-shadow:var(--shadow);z-index:100;margin-top:6px;
  }
  .col-visibility-dropdown.show{display:block;}
  .col-visibility-dropdown label{display:flex;align-items:center;gap:8px;padding:4px 0;cursor:pointer;font-size:.83rem;}
  .col-visibility-dropdown label:hover{background:var(--paper);}
  .col-visibility-dropdown input[type="checkbox"]{accent-color:var(--brand);width:15px;height:15px;cursor:pointer;}
  .col-visibility-toggle{
    background:var(--surface);border:1px solid var(--line);padding:7px 14px;border-radius:8px;
    cursor:pointer;font-size:.84rem;display:flex;align-items:center;gap:6px;color:var(--ink);
  }
  .col-visibility-toggle:hover{background:var(--paper);}
  .badge-count{background:var(--brand);color:#fff;border-radius:50%;padding:0 6px;font-size:.68rem;min-width:18px;text-align:center;font-family:'JetBrains Mono',monospace;}

  /* ---------- TABLE ---------- */
  .table-wrap{
    overflow:auto;margin-top:16px;border-radius:12px;border:1px solid var(--line);
    max-height:65vh;background:var(--surface);box-shadow:var(--shadow);
  }
  table{width:100%;border-collapse:collapse;font-size:.86rem;}
  th{
    background:#f6f8fb;text-align:left;padding:11px 10px;position:sticky;top:0;z-index:10;
    white-space:nowrap;border-bottom:1px solid var(--line);font-weight:600;color:var(--ink-soft);
    font-size:.76rem;text-transform:uppercase;letter-spacing:.4px;cursor:pointer;user-select:none;
  }
  th:hover{color:var(--brand);}
  th .arrow{opacity:.4;font-size:.7rem;margin-left:3px;}
  th.sorted .arrow{opacity:1;color:var(--brand);}
  td{padding:9px 10px;border-top:1px solid var(--line-soft);vertical-align:middle;font-family:'JetBrains Mono',monospace;font-size:.82rem;}
  td.data-cell{font-family:'JetBrains Mono',monospace;}
  tr:hover td{background:#fafcfe;}

  .status-select{
    padding:4px 9px;border-radius:20px;border:1px solid var(--line);font-size:.76rem;
    font-weight:600;background:#fff;cursor:pointer;min-width:112px;appearance:auto;
    font-family:'Inter',sans-serif;
  }
  .status-select:focus{outline:2px solid var(--brand);border-color:transparent;}
  .status-select.option-settled{border-color:var(--settled-line);color:var(--settled);background:var(--settled-bg);}
  .status-select.option-pending{border-color:var(--pending-line);color:var(--pending);background:var(--pending-bg);}
  .status-select.option-incomplete{border-color:var(--incomplete-line);color:var(--incomplete);background:var(--incomplete-bg);}
  .remark-input{
    border:1px solid var(--line);border-radius:6px;padding:5px 7px;width:100%;min-width:100px;
    font-size:.78rem;font-family:'Inter',sans-serif;
  }
  .remark-input:focus{outline:1px solid var(--brand);border-color:var(--brand);}

  .empty-state{text-align:center;padding:52px 20px;color:var(--ink-soft);}
  .empty-state p{margin:8px 0;}
  .empty-state .icon{font-size:2rem;margin-bottom:6px;}

  .banner{
    display:none;align-items:center;gap:10px;padding:11px 16px;border-radius:10px;
    font-size:.85rem;margin-top:14px;border:1px solid transparent;
  }
  .banner.show{display:flex;}
  .banner.error{background:var(--pending-bg);border-color:var(--pending-line);color:var(--pending);}
  .banner.info{background:var(--brand-tint);border-color:#c8dbd7;color:var(--brand-dark);}
  .banner button{margin-left:auto;flex-shrink:0;}

  .footer-actions{display:flex;gap:12px;margin-top:18px;flex-wrap:wrap;align-items:center;}
  .source-tag{
    font-size:.74rem;color:var(--ink-soft);margin-left:auto;display:flex;align-items:center;gap:8px;
    background:var(--surface);border:1px solid var(--line);padding:6px 12px;border-radius:8px;
  }
  .source-tag .lock{opacity:.6;}
  .source-tag code{
    background:var(--paper);padding:2px 6px;border-radius:5px;font-family:'JetBrains Mono',monospace;
    max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;vertical-align:bottom;
  }
  .legend-chip{font-size:.78rem;color:var(--ink-soft);}
  .legend-chip span{padding:2px 9px;border-radius:12px;font-weight:600;font-size:.74rem;}

  @media (max-width:700px){
    .stats{margin-left:0;width:100%;}
    .search-box{min-width:140px;}
    .masthead{flex-direction:column;align-items:flex-start;}
    .source-tag{margin-left:0;width:100%;}
  }
  @media (prefers-reduced-motion: reduce){
    .refresh-btn .spin.on{animation:none;}
    .sync-dot.loading{animation:none;}
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="masthead">
    <div>
      <div class="eyebrow">DA-RFO I · General Services Section</div>
      <h1>⛽ Gasoline Liquidation Tracker</h1>
      <div style="font-size:.85rem;color:#c7ddd8;">Receipt-level settlement status, synced from the official log</div>
    </div>
    <div class="sync-panel">
      <span class="sync-dot" id="syncDot"></span>
      <div>
        <div id="syncLabel">Not synced yet</div>
        <div id="syncTime">—</div>
      </div>
      <button class="refresh-btn" id="refreshBtn"><span class="spin" id="refreshSpin">⟳</span> Refresh</button>
    </div>
  </div>

  <div class="gauge-card">
    <div class="gauge-top">
      <span class="title">Liquidation progress</span>
      <span class="pct" id="gaugePct">0% settled</span>
    </div>
    <div class="gauge-track">
      <div class="gauge-seg settled" id="segSettled" style="width:0%"></div>
      <div class="gauge-seg incomplete" id="segIncomplete" style="width:0%"></div>
      <div class="gauge-seg pending" id="segPending" style="width:0%"></div>
    </div>
    <div class="gauge-legend">
      <span class="item"><span class="sw settled"></span>Settled <b id="legSettled">0</b></span>
      <span class="item"><span class="sw incomplete"></span>Incomplete <b id="legIncomplete">0</b></span>
      <span class="item"><span class="sw pending"></span>Pending <b id="legPending">0</b></span>
      <span class="item">Total <b id="legTotal">0</b></span>
    </div>
  </div>

  <div class="banner error" id="errorBanner">
    <span>⚠️</span>
    <span id="errorText">Could not reach the data source.</span>
    <button id="retryBtn">Retry</button>
  </div>

  <div class="toolbar">
    <div class="controls">
      <input type="text" id="searchBox" class="search-box" placeholder="🔍 Search receipts...">
      <div class="col-visibility">
        <button class="col-visibility-toggle" id="colVisibilityToggle">📊 Columns <span class="badge-count" id="colCountBadge">0</span></button>
        <div class="col-visibility-dropdown" id="colVisibilityDropdown">
          <div style="font-weight:600;font-size:.78rem;color:var(--ink-soft);padding-bottom:6px;border-bottom:1px solid var(--line);margin-bottom:6px;">Show / hide columns</div>
          <div id="colCheckboxList"></div>
          <div style="border-top:1px solid var(--line);margin-top:6px;padding-top:6px;display:flex;gap:8px;flex-wrap:wrap;">
            <button id="showAllCols" style="font-size:.72rem;padding:3px 10px;">Show all</button>
            <button id="hideAllCols" style="font-size:.72rem;padding:3px 10px;">Hide all</button>
          </div>
        </div>
      </div>
      <label class="file-label" for="csvUpload">📂 Load CSV manually</label>
      <input type="file" id="csvUpload" accept=".csv">
      <button id="resetBtn" class="ghost">↺ Reset statuses</button>
    </div>
    <div class="stats" id="statsDisplay">
      <div class="stat settled"><span class="stat-label">Settled</span> <span class="stat-value" id="countSettled">0</span></div>
      <div class="stat pending"><span class="stat-label">Pending</span> <span class="stat-value" id="countPending">0</span></div>
      <div class="stat incomplete"><span class="stat-label">Incomplete</span> <span class="stat-value" id="countIncomplete">0</span></div>
      <div class="stat"><span class="stat-label" style="color:var(--ink-soft);">Total</span> <span class="stat-value" id="countTotal">0</span></div>
    </div>
  </div>

  <div class="table-wrap" id="tableWrap">
    <div class="empty-state" id="emptyState">
      <div class="icon">⛽</div>
      <p>Connecting to the liquidation log…</p>
      <p style="font-size:.85rem;">If nothing loads, use <strong>“Load CSV manually”</strong> as a fallback.</p>
    </div>
    <table id="dataTable" style="display:none;">
      <thead id="tableHead"></thead>
      <tbody id="tableBody"></tbody>
    </table>
  </div>

  <div class="footer-actions">
    <button id="exportBtn" class="primary">💾 Export marked CSV</button>
    <button id="clearEditsBtn" class="danger">🗑️ Clear saved statuses</button>
    <span class="legend-chip">
      <span style="background:var(--settled-bg);color:var(--settled);">Settled</span>
      <span style="background:var(--pending-bg);color:var(--pending);">Pending</span>
      <span style="background:var(--incomplete-bg);color:var(--incomplete);">Incomplete</span>
    </span>
    <span class="source-tag"><span class="lock">🔒</span> Source: <code id="sourceUrlLabel"></code></span>
  </div>

</div>

<script>
(function(){
  // ----- FIXED DATA SOURCE (locked) -----
  const SHEET_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSJF9zFlZ6Cf_wqIDALZHjVPCdjoo9xCNa10G-8r6TROtED1jNPhAmDEV7ETuzBc4sybYrPfCdOC_pi/pub?gid=1322434383&single=true&output=csv";
  const STORAGE_KEY = "gasLiquidation_edits_v1";
  const AUTO_REFRESH_MS = 5 * 60 * 1000; // 5 minutes

  // ----- STATE -----
  let currentData = [];
  let filteredData = [];
  let headers = [];
  let searchTerm = '';
  let columnVisibility = {};
  let sortCol = null;
  let sortDir = 1; // 1 asc, -1 desc

  // ----- DOM REFS -----
  const fileInput = document.getElementById('csvUpload');
  const resetBtn = document.getElementById('resetBtn');
  const exportBtn = document.getElementById('exportBtn');
  const clearEditsBtn = document.getElementById('clearEditsBtn');
  const searchBox = document.getElementById('searchBox');
  const tableHead = document.getElementById('tableHead');
  const tableBody = document.getElementById('tableBody');
  const dataTable = document.getElementById('dataTable');
  const emptyState = document.getElementById('emptyState');
  const countSettled = document.getElementById('countSettled');
  const countPending = document.getElementById('countPending');
  const countIncomplete = document.getElementById('countIncomplete');
  const countTotal = document.getElementById('countTotal');
  const colVisibilityToggle = document.getElementById('colVisibilityToggle');
  const colVisibilityDropdown = document.getElementById('colVisibilityDropdown');
  const colCheckboxList = document.getElementById('colCheckboxList');
  const showAllCols = document.getElementById('showAllCols');
  const hideAllCols = document.getElementById('hideAllCols');
  const colCountBadge = document.getElementById('colCountBadge');
  const refreshBtn = document.getElementById('refreshBtn');
  const refreshSpin = document.getElementById('refreshSpin');
  const syncDot = document.getElementById('syncDot');
  const syncLabel = document.getElementById('syncLabel');
  const syncTime = document.getElementById('syncTime');
  const errorBanner = document.getElementById('errorBanner');
  const errorText = document.getElementById('errorText');
  const retryBtn = document.getElementById('retryBtn');
  const sourceUrlLabel = document.getElementById('sourceUrlLabel');

  sourceUrlLabel.textContent = SHEET_URL.length > 46 ? SHEET_URL.slice(0, 46) + '…' : SHEET_URL;
  sourceUrlLabel.title = SHEET_URL;

  // ----- LOCAL EDIT PERSISTENCE -----
  function loadEdits(){
    try{ return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); }
    catch(e){ return {}; }
  }
  function saveEdits(edits){
    try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(edits)); }catch(e){}
  }
  function rowKey(row, hdrs){
    // Stable hash from the row's actual data values, so edits survive re-sync
    // even if row order shifts, as long as the receipt's content is unchanged.
    let str = hdrs.map(h => (row[h] || '').toString().trim()).join('|');
    let hash = 0;
    for (let i = 0; i < str.length; i++){
      hash = ((hash << 5) - hash) + str.charCodeAt(i);
      hash |= 0;
    }
    return 'r' + hash;
  }

  // ----- SYNC STATUS UI -----
  function setSyncState(state, message){
    syncDot.className = 'sync-dot' + (state === 'loading' ? ' loading' : state === 'error' ? ' err' : '');
    syncLabel.textContent = message;
    if (state === 'ok'){
      syncTime.textContent = 'Last synced ' + new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
    }
    refreshSpin.classList.toggle('on', state === 'loading');
    refreshBtn.disabled = state === 'loading';
  }
  function showError(msg){
    errorText.textContent = msg;
    errorBanner.classList.add('show');
  }
  function hideError(){ errorBanner.classList.remove('show'); }

  // ----- FETCH FROM GOOGLE SHEET -----
  async function syncFromSheet(){
    setSyncState('loading', 'Syncing…');
    hideError();
    try{
      const res = await fetch(SHEET_URL, { cache: 'no-store' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const text = await res.text();
      if (!text || text.trim().length === 0) throw new Error('Empty response');
      loadCSV(text);
      setSyncState('ok', 'Synced from log');
    }catch(err){
      setSyncState('error', 'Sync failed');
      showError('Could not reach the liquidation log (' + err.message + '). Showing the last loaded data if any, or use "Load CSV manually" below.');
    }
  }

  retryBtn.addEventListener('click', syncFromSheet);
  refreshBtn.addEventListener('click', syncFromSheet);

  // ----- HELPERS -----
  function updateStats(){
    const data = filteredData.length ? filteredData : currentData;
    const settled = data.filter(r => r._status === 'Settled').length;
    const pending = data.filter(r => r._status === 'Pending').length;
    const incomplete = data.filter(r => r._status === 'Incomplete').length;
    const total = data.length;
    countSettled.textContent = settled;
    countPending.textContent = pending;
    countIncomplete.textContent = incomplete;
    countTotal.textContent = total;

    document.getElementById('legSettled').textContent = settled;
    document.getElementById('legIncomplete').textContent = incomplete;
    document.getElementById('legPending').textContent = pending;
    document.getElementById('legTotal').textContent = total;
    const pct = total ? Math.round((settled / total) * 100) : 0;
    document.getElementById('gaugePct').textContent = pct + '% settled';
    document.getElementById('segSettled').style.width = (total ? settled/total*100 : 0) + '%';
    document.getElementById('segIncomplete').style.width = (total ? incomplete/total*100 : 0) + '%';
    document.getElementById('segPending').style.width = (total ? pending/total*100 : 0) + '%';
  }

  function getVisibleHeaders(){ return headers.filter(h => columnVisibility[h] !== false); }
  function updateColBadge(){ colCountBadge.textContent = getVisibleHeaders().length; }

  function applySearch(){
    const term = searchTerm.toLowerCase().trim();
    if (!term){ filteredData = []; renderTable(); return; }
    filteredData = currentData.filter(row => {
      let match = false;
      headers.forEach(h => { if (String(row[h] || '').toLowerCase().includes(term)) match = true; });
      if (String(row._remark || '').toLowerCase().includes(term)) match = true;
      if (String(row._status || '').toLowerCase().includes(term)) match = true;
      return match;
    });
    renderTable();
  }

  function sortData(list){
    if (!sortCol) return list;
    const copy = list.slice();
    copy.sort((a, b) => {
      let va, vb;
      if (sortCol === '_status'){ va = a._status || ''; vb = b._status || ''; }
      else { va = a[sortCol] || ''; vb = b[sortCol] || ''; }
      const na = parseFloat(String(va).replace(/[^0-9.\-]/g, ''));
      const nb = parseFloat(String(vb).replace(/[^0-9.\-]/g, ''));
      let cmp;
      if (!isNaN(na) && !isNaN(nb) && String(va).trim() !== '' && String(vb).trim() !== ''){
        cmp = na - nb;
      } else {
        cmp = String(va).localeCompare(String(vb), undefined, {numeric:true, sensitivity:'base'});
      }
      return cmp * sortDir;
    });
    return copy;
  }

  function renderTable(){
    let data = filteredData.length ? filteredData : currentData;
    const visibleHeaders = getVisibleHeaders();
    data = sortData(data);

    if (!data.length){
      dataTable.style.display = 'none';
      emptyState.style.display = 'block';
      if (currentData.length && filteredData.length === 0 && searchTerm){
        emptyState.innerHTML = `<div class="icon">🔍</div><p>No results match "<strong>${escapeHtml(searchTerm)}</strong>"</p><p style="font-size:.85rem;">Try a different search term, or clear the search box.</p>`;
      } else if (!currentData.length) {
        emptyState.innerHTML = `<div class="icon">⛽</div><p>Connecting to the liquidation log…</p><p style="font-size:.85rem;">If nothing loads, use <strong>"Load CSV manually"</strong> as a fallback.</p>`;
      }
      updateStats(); updateColBadge();
      return;
    }
    emptyState.style.display = 'none';
    dataTable.style.display = 'table';

    let theadHtml = '<tr>';
    theadHtml += `<th style="width:118px;position:sticky;left:0;background:#f6f8fb;z-index:11;" data-sort="_status">Status<span class="arrow">${sortArrow('_status')}</span></th>`;
    theadHtml += '<th style="width:150px;position:sticky;left:118px;background:#f6f8fb;z-index:11;">Remark</th>';
    visibleHeaders.forEach(h => {
      theadHtml += `<th data-sort="${escapeHtml(h)}" class="${sortCol===h?'sorted':''}">${escapeHtml(h)}<span class="arrow">${sortArrow(h)}</span></th>`;
    });
    theadHtml += '</tr>';
    tableHead.innerHTML = theadHtml;

    let tbodyHtml = '';
    data.forEach(row => {
      const originalIdx = currentData.indexOf(row);
      const status = row._status || 'Pending';
      const optionClass = status === 'Settled' ? 'option-settled' : status === 'Pending' ? 'option-pending' : 'option-incomplete';
      tbodyHtml += '<tr>';
      tbodyHtml += `<td style="position:sticky;left:0;background:white;z-index:5;">
        <select class="status-select ${optionClass}" data-index="${originalIdx}" data-action="status">
          <option value="Pending" ${status==='Pending'?'selected':''}>⏳ Pending</option>
          <option value="Incomplete" ${status==='Incomplete'?'selected':''}>⚠️ Incomplete</option>
          <option value="Settled" ${status==='Settled'?'selected':''}>✅ Settled</option>
        </select></td>`;
      tbodyHtml += `<td style="position:sticky;left:118px;background:white;z-index:5;">
        <input class="remark-input" type="text" data-index="${originalIdx}" data-action="remark" value="${escapeHtml(row._remark||'')}" placeholder="Add note...">
        </td>`;
      visibleHeaders.forEach(h => {
        const val = row[h] !== undefined && row[h] !== null ? row[h] : '';
        tbodyHtml += `<td class="data-cell">${escapeHtml(String(val))}</td>`;
      });
      tbodyHtml += '</tr>';
    });
    tableBody.innerHTML = tbodyHtml;
    updateStats(); updateColBadge();

    document.querySelectorAll('[data-action="status"]').forEach(sel => {
      sel.addEventListener('change', function(){
        const idx = parseInt(this.dataset.index);
        if (!isNaN(idx) && currentData[idx]){
          currentData[idx]._status = this.value;
          persistRowEdit(currentData[idx]);
          if (filteredData.length) applySearch(); else renderTable();
        }
      });
    });
    document.querySelectorAll('[data-action="remark"]').forEach(inp => {
      inp.addEventListener('change', function(){
        const idx = parseInt(this.dataset.index);
        if (!isNaN(idx) && currentData[idx]){
          currentData[idx]._remark = this.value;
          persistRowEdit(currentData[idx]);
        }
      });
    });

    tableHead.querySelectorAll('th[data-sort]').forEach(th => {
      th.addEventListener('click', function(){
        const col = this.dataset.sort;
        if (sortCol === col) sortDir *= -1; else { sortCol = col; sortDir = 1; }
        renderTable();
      });
    });
  }

  function sortArrow(col){
    if (sortCol !== col) return '↕';
    return sortDir === 1 ? '↑' : '↓';
  }

  function persistRowEdit(row){
    const edits = loadEdits();
    const key = rowKey(row, headers);
    edits[key] = { status: row._status, remark: row._remark };
    saveEdits(edits);
  }

  function escapeHtml(text){
    if (!text) return '';
    return String(text).replace(/[&<>"]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
  }

  // ----- COLUMN VISIBILITY -----
  function rebuildColumnCheckboxes(){
    if (headers.length === 0){
      colCheckboxList.innerHTML = '<div style="color:#94a3b8;font-size:.78rem;">No columns loaded</div>';
      return;
    }
    let html = '';
    headers.forEach(h => {
      const checked = columnVisibility[h] !== false;
      html += `<label><input type="checkbox" data-col="${escapeHtml(h)}" ${checked?'checked':''}>${escapeHtml(h)}</label>`;
    });
    colCheckboxList.innerHTML = html;
    colCheckboxList.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', function(){
        columnVisibility[this.dataset.col] = this.checked;
        renderTable();
      });
    });
    updateColBadge();
  }

  // ----- LOAD + MERGE DATA -----
  function loadCSV(csvText){
    const lines = csvText.split(/\r?\n/).filter(l => l.trim() !== '');
    if (lines.length < 2){
      showError('The data source returned no rows.');
      return;
    }
    const rawHeaders = parseCSVLine(lines[0]);
    const newHeaders = rawHeaders.map(h => h.trim());
    const edits = loadEdits();

    const newData = [];
    for (let i = 1; i < lines.length; i++){
      const values = parseCSVLine(lines[i]);
      if (values.length === 0 || values.every(v => v.trim() === '')) continue;
      const row = {};
      newHeaders.forEach((h, idx) => { row[h] = idx < values.length ? values[idx].trim() : ''; });
      const key = rowKey(row, newHeaders);
      const saved = edits[key];
      row._status = saved ? saved.status : 'Pending';
      row._remark = saved ? saved.remark : '';
      newData.push(row);
    }

    if (newData.length === 0){
      showError('The data source has a header row but no data rows yet.');
      return;
    }

    headers = newHeaders;
    // preserve visibility choices for columns that still exist
    const nextVisibility = {};
    headers.forEach(h => { nextVisibility[h] = columnVisibility[h] !== false; });
    columnVisibility = nextVisibility;

    currentData = newData;
    filteredData = [];
    if (searchTerm) applySearch();
    rebuildColumnCheckboxes();
    renderTable();
  }

  function parseCSVLine(line){
    const result = [];
    let current = '', inQuotes = false;
    for (let i = 0; i < line.length; i++){
      const ch = line[i];
      if (inQuotes){
        if (ch === '"' && line[i+1] === '"'){ current += '"'; i++; }
        else if (ch === '"'){ inQuotes = false; }
        else current += ch;
      } else {
        if (ch === '"') inQuotes = true;
        else if (ch === ','){ result.push(current); current = ''; }
        else current += ch;
      }
    }
    result.push(current);
    return result;
  }

  // ----- MANUAL FALLBACK UPLOAD -----
  fileInput.addEventListener('change', function(){
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => { loadCSV(ev.target.result); setSyncState('ok', 'Loaded from manual file'); syncTime.textContent = 'Manual upload'; hideError(); };
    reader.readAsText(file);
    this.value = '';
  });

  // ----- BUTTON EVENTS -----
  resetBtn.addEventListener('click', function(){
    if (currentData.length === 0) return;
    if (confirm('Reset all statuses on this screen to "Pending"? This clears saved statuses for every visible receipt.')){
      const edits = loadEdits();
      currentData.forEach(row => {
        row._status = 'Pending';
        row._remark = '';
        delete edits[rowKey(row, headers)];
      });
      saveEdits(edits);
      filteredData = [];
      searchBox.value = ''; searchTerm = '';
      renderTable();
    }
  });

  clearEditsBtn.addEventListener('click', function(){
    if (confirm('Clear all saved statuses and remarks from this browser? This cannot be undone.')){
      localStorage.removeItem(STORAGE_KEY);
      syncFromSheet();
    }
  });

  searchBox.addEventListener('input', function(){ searchTerm = this.value; applySearch(); });

  colVisibilityToggle.addEventListener('click', function(e){
    e.stopPropagation();
    colVisibilityDropdown.classList.toggle('show');
  });
  document.addEventListener('click', function(e){
    if (!colVisibilityToggle.contains(e.target) && !colVisibilityDropdown.contains(e.target)){
      colVisibilityDropdown.classList.remove('show');
    }
  });
  showAllCols.addEventListener('click', function(){
    headers.forEach(h => columnVisibility[h] = true);
    rebuildColumnCheckboxes(); renderTable();
    colVisibilityDropdown.classList.remove('show');
  });
  hideAllCols.addEventListener('click', function(){
    headers.forEach(h => columnVisibility[h] = false);
    rebuildColumnCheckboxes(); renderTable();
    colVisibilityDropdown.classList.remove('show');
  });

  exportBtn.addEventListener('click', function(){
    if (currentData.length === 0){ alert('No data to export.'); return; }
    let csvContent = 'Status,Remark,' + headers.join(',') + '\n';
    currentData.forEach(row => {
      const status = row._status || 'Pending';
      const remark = (row._remark || '').replace(/,/g, ';');
      const rowValues = headers.map(h => {
        let val = (row[h] || '').toString();
        if (val.includes(',') || val.includes('"') || val.includes('\n')) val = '"' + val.replace(/"/g,'""') + '"';
        return val;
      });
      csvContent += `${status},${remark},${rowValues.join(',')}\n`;
    });
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `gasoline_liquidation_${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // ----- INIT -----
  syncFromSheet();
  setInterval(syncFromSheet, AUTO_REFRESH_MS);
})();
</script>
</body>
</html>
